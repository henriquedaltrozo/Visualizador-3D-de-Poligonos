# Cone com ponta
mtllib cone.mtl

# Vértice do topo (ponta do cone)
v 0.0 1.0 0.0

# Base do cone (círculo com 8 vértices)
v 1.0 -1.0 0.0
v 0.707 -1.0 0.707
v 0.0 -1.0 1.0
v -0.707 -1.0 0.707
v -1.0 -1.0 0.0
v -0.707 -1.0 -0.707
v 0.0 -1.0 -1.0
v 0.707 -1.0 -0.707

# Centro da base
v 0.0 -1.0 0.0

usemtl cylinder_material

# Faces laterais do cone (conectam topo aos vértices da base)
f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 6
f 1 6 7
f 1 7 8
f 1 8 9
f 1 9 2

# Base do cone (fan triangulation)
f 10 3 2
f 10 4 3
f 10 5 4
f 10 6 5
f 10 7 6
f 10 8 7
f 10 9 8
f 10 2 9
