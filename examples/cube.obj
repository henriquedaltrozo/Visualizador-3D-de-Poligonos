# Cubo simples para testes de transformação
mtllib cube.mtl

# Vértices do cubo
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Faces (2 triângulos por face)
usemtl cube_material

# Face frontal (Z+)
f 5 6 7
f 5 7 8

# Face traseira (Z-)
f 2 1 4
f 2 4 3

# Face superior (Y+)
f 8 7 3
f 8 3 4

# Face inferior (Y-)
f 1 2 6
f 1 6 5

# Face direita (X+)
f 6 2 3
f 6 3 7

# Face esquerda (X-)
f 1 5 8
f 1 8 4
